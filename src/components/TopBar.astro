---
import Icon from './Icon.astro';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs?: Crumb[];
}
const { crumbs = [] } = Astro.props;
---

<header class="top">
  <nav class="crumbs" aria-label="مسیر">
    {crumbs.map((c, i) => (
      <>
        {i > 0 && <Icon name="chevron" size={13} class="crumbs__sep" />}
        {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
      </>
    ))}
  </nav>

  <div class="top__actions">
    <button class="search-trigger" id="searchTrigger" aria-label="جست‌وجو">
      <Icon name="search" size={16} />
      <span>جست‌وجوی موضوع‌ها…</span>
      <kbd class="ltr">⌘K</kbd>
    </button>

    <button class="icon-btn" id="themeToggle" aria-label="تغییر پوستهٔ روشن و تاریک" title="پوسته">
      <Icon name="sun" size={17} class="only-light" />
      <Icon name="moon" size={17} class="only-dark" />
    </button>

    <button class="icon-btn nav-toggle" id="navToggle" aria-label="فهرست بخش‌ها" aria-expanded="false">
      <Icon name="menu" size={18} />
    </button>
  </div>
</header>

<dialog class="search" id="searchDialog" aria-label="جست‌وجو">
  <div class="search__box">
    <div id="pagefind"></div>
  </div>
</dialog>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    min-height: var(--header-h);
    margin: calc(var(--sp-5) * -1) calc(var(--sp-5) * -1) var(--sp-5);
    padding: var(--sp-3) var(--sp-5);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .top { margin: calc(var(--sp-4) * -1) calc(var(--sp-4) * -1) var(--sp-4); padding-inline: var(--sp-4); }
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex: 1;
    min-width: 0;
    font-size: 13.5px;
    color: var(--text-muted);
    overflow: hidden;
  }
  .crumbs a { color: var(--text-muted); }
  .crumbs a:hover { color: var(--text); }
  .crumbs [aria-current] { color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .crumbs__sep { flex: none; transform: rotate(180deg); color: var(--text-dim); }

  .top__actions { display: flex; align-items: center; gap: var(--sp-2); flex: none; }

  .search-trigger {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    width: min(340px, 38vw);
    padding: 8px var(--sp-3);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-dim);
    cursor: pointer;
    font-size: 13.5px;
  }
  .search-trigger:hover { border-color: var(--border-strong); }
  .search-trigger span { flex: 1; text-align: start; }
  .search-trigger kbd {
    font-size: 11px;
    padding: 1px 6px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  @media (max-width: 720px) {
    .search-trigger span, .search-trigger kbd { display: none; }
    .search-trigger { width: 38px; height: 38px; justify-content: center; padding: 0; }
  }

  .nav-toggle { display: none; }
  @media (max-width: 1023px) { .nav-toggle { display: inline-grid; } }

  :global(html[data-theme='dark']) .only-light,
  :global(html[data-theme='light']) .only-dark { display: none; }

  .search {
    width: min(680px, 92vw);
    margin-top: 10vh;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
  }
  .search::backdrop { background: var(--scrim); backdrop-filter: blur(2px); }
  .search__box { padding: var(--sp-4); max-height: 70dvh; overflow-y: auto; }
</style>
