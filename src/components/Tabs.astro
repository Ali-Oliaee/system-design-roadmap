---
import Icon from './Icon.astro';
import type { Tab } from '../lib/types';

interface Props {
  tabs: Tab[];
}
const { tabs } = Astro.props;
---

<div class="tabs" role="tablist">
  {tabs.map((t, i) => (
    <button
      role="tab"
      class="tabs__btn"
      id={`tab-${t.id}`}
      data-tab={t.id}
      aria-selected={i === 0 ? 'true' : 'false'}
      aria-controls={`panel-${t.id}`}
      tabindex={i === 0 ? 0 : -1}
    >
      <Icon name={t.icon} size={16} />
      <span>{t.label}</span>
      {t.count !== undefined && <span class="tabs__count ltr">{t.count}</span>}
    </button>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('.tabs').forEach((bar) => {
    const btns = [...bar.querySelectorAll<HTMLButtonElement>('.tabs__btn')];
    const panels = new Map(
      btns.map((b) => [b.dataset.tab!, document.getElementById(`panel-${b.dataset.tab}`)]),
    );

    const select = (id: string, focus = false) => {
      btns.forEach((b) => {
        const on = b.dataset.tab === id;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      });
      panels.forEach((p, key) => p?.toggleAttribute('hidden', key !== id));
      history.replaceState(null, '', `#${id}`);
    };

    btns.forEach((b) => b.addEventListener('click', () => select(b.dataset.tab!)));

    bar.addEventListener('keydown', (e) => {
      const i = btns.findIndex((b) => b.getAttribute('aria-selected') === 'true');
      // در RTL جهت فلش‌ها برعکس است
      const step = e.key === 'ArrowLeft' ? 1 : e.key === 'ArrowRight' ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      select(btns[(i + step + btns.length) % btns.length].dataset.tab!, true);
    });

    // ورود با هش مستقیم: /redis#resources
    const hash = location.hash.slice(1);
    if (hash && panels.has(hash)) select(hash);
  });
</script>

<style>
  .tabs {
    display: flex;
    gap: var(--sp-1);
    overflow-x: auto;
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--sp-5);
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar { display: none; }

  .tabs__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 10px var(--sp-4);
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    font-size: 14px;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .tabs__btn:hover { color: var(--text); }
  .tabs__btn[aria-selected='true'] { color: var(--accent-text); border-bottom-color: var(--accent); }

  .tabs__count {
    font-size: 11.5px;
    padding: 0 6px;
    border-radius: 99px;
    background: var(--surface-2);
    color: var(--text-dim);
  }
</style>
